# Copia este archivo a .env.local y llena los valores.
# .env.local NUNCA se sube al repo.

# --- Mercado Pago ---------------------------------------------------------

# Access token.
# Sandbox: empieza con TEST-  |  Produccion: empieza con APP_USR-
# Panel > Tus integraciones > tu app > Credenciales
MP_ACCESS_TOKEN=TEST-0000000000000000-000000-00000000000000000000000000000000-000000000

# Secreto de firma del webhook.
# Panel > Tus integraciones > tu app > Webhooks > Configurar notificaciones
MP_WEBHOOK_SECRET=

# URL publica del sitio. En Vercel se resuelve sola y puedes dejarla vacia.
# En local ponla al tunel de ngrok si quieres recibir webhooks de verdad.
APP_BASE_URL=http://localhost:3000

# --- Supabase -------------------------------------------------------------

# En local salen de `npx supabase start`.
# En produccion: panel de Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# La service role key se salta RLS por completo. Solo la usa el webhook de
# pagos. Jamas con prefijo NEXT_PUBLIC_, jamas en el navegador.
SUPABASE_SERVICE_ROLE_KEY=
